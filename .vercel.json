{
  "version": 2,
  "builds": [
    {
      "src": "real-state-client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "real-estate-server/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/real-estate-server/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/real-state-client/$1"
    }
  ]
}